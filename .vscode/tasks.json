{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile MQL5",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/compile.ps1",
        "-ExePath",
        "${config:mql5.metaeditorPath}",
        "-SourceFile",
        "${workspaceFolder}/${config:mql5.rootFile}",
        "-LogFile",
        "${workspaceFolder}/compile.log"
      ],
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}

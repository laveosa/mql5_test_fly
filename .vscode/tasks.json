{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile MQL5",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/compile.ps1",
        "-ExePath",
        "C:\\Program Files\\RoboForex MT5 Terminal\\metaeditor64.exe",
        "-SourceFile",
        "${file}",
        "-LogFile",
        "${fileDirname}\\compile.log"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": false,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
